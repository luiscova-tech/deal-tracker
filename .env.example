# Nellis Auction — value of the __shopping-location cookie (controls which
# warehouses' items show up; without it Nellis defaults to Las Vegas and
# returns no Mesa/Phoenix results). To get it: pick your location at
# nellisauction.com, then copy the __shopping-location cookie's value from
# your browser's DevTools (Application/Storage tab > Cookies). Not
# login-tied, just a location preference. Current value expires 2027-09-02.
NELLIS_SHOPPING_LOCATION_COOKIE=

# Supabase (leave unset to run against fake in-memory data — see db/repository.py)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Email notifications via SMTP (leave unset to skip this channel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL_TO=you@example.com

# Push notifications via ntfy.sh (leave unset to skip this channel)
NTFY_TOPIC=your-private-topic-name
