# Supabase (leave unset to run against fake in-memory data — see db/repository.py)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Email notifications via SMTP (leave unset to skip this channel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL_TO=you@example.com

# Push notifications via ntfy.sh (leave unset to skip this channel)
NTFY_TOPIC=your-private-topic-name
